# ==============================================================================
# LINCOZ ENTERPRISE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# SECURITY RULE 1: Never commit actual secret keys or credentials to Git.
# Copy this file to .env and provide your private values.

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite Client-Side)
# Only variables prefixed with VITE_ are exposed to the browser.
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
VITE_APP_ENV=development

# ------------------------------------------------------------------------------
# 2. SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL / Supabase with Connection Pooling)
# ------------------------------------------------------------------------------
# Pooled Connection URL (Supavisor Transaction mode, Port 6543):
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct Connection URL (Session mode / Migrations, Port 5432):
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# 4. CACHE & RATE LIMITING (Redis)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION & JWT SECURITY (Min 32 characters for secrets)
# Generate using: openssl rand -base64 32
# ------------------------------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_SALT_ROUNDS=12

# ------------------------------------------------------------------------------
# 6. OBJECT STORAGE (AWS S3 / Cloudflare R2 / MinIO)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 7. AI & LLM PROXY CONFIGURATION (Google Gemini API)
# Stored strictly on the backend. Never exposed to the client.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_AI_TOKENS_PER_REQUEST=500
DAILY_TOKEN_BUDGET_PER_USER=20000

# ------------------------------------------------------------------------------
# 8. MONITORING & ERROR LOGGING (Optional for Production)
# ------------------------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=info
