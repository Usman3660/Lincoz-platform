// ==============================================================================
// LINCOZ ENTERPRISE - PRISMA SCHEMA (POSTGRESQL + MULTI-TENANT ARCHITECTURE)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------------------
// MULTI-TENANCY FOUNDATION (Single Company Today -> Enterprise SaaS Tomorrow)
// ------------------------------------------------------------------------------
model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  plan        String   @default("ENTERPRISE") // "STARTER", "GROWTH", "ENTERPRISE"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users              User[]
  clients            Client[]
  projects           Project[]
  tasks              Task[]
  invoices           ClientInvoice[]
  payouts            Payout[]
  expenses           DirectExpense[]
  expenseCategories  ExpenseCategory[]
  ledgerEntries      FinancialLedger[]
  attendanceRecords  AttendanceRecord[]
  auditLogs          AuditLog[]

  @@map("organizations")
}

// ------------------------------------------------------------------------------
// USER & IDENTITY (RBAC: SUPER_ADMIN, PROJECT_MANAGER, ONSITE_MEMBER, PARTNER)
// ------------------------------------------------------------------------------
enum UserRole {
  SUPER_ADMIN
  PROJECT_MANAGER
  ONSITE_MEMBER
  PARTNER
}

enum CompensationType {
  SALARIED
  PERCENTAGE
}

enum WorkMode {
  ONSITE
  REMOTE
  HYBRID
}

model User {
  id               String           @id @default(uuid())
  organizationId   String
  name             String
  email            String           @unique
  passwordHash     String           // Rule 4: bcrypt min cost 12
  role             UserRole         @default(ONSITE_MEMBER)
  title            String?
  department       String?
  workMode         WorkMode         @default(ONSITE)
  compensationType CompensationType @default(SALARIED)
  salary           Decimal          @default(0) @db.Decimal(12, 2)
  sharePercentage  Decimal          @default(0) @db.Decimal(5, 2)
  avatarUrl        String?
  isMfaEnabled     Boolean          @default(false)
  mfaKey           String?          @default("8892")
  failedAttempts   Int              @default(0) // Rule 4: Account Lockout tracking
  lockedUntil      DateTime?
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTasks    Task[]           @relation("TaskAssignee")
  payouts          Payout[]         @relation("PayoutRecipient")
  attendanceLogs   AttendanceRecord[]
  auditEvents      AuditLog[]       @relation("AuditActor")

  @@index([organizationId, email])
  @@index([organizationId, role])
  @@map("users")
}

// ------------------------------------------------------------------------------
// CLIENT DIRECTORY & CONTRACTS
// ------------------------------------------------------------------------------
model Client {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  company        String
  email          String
  phone          String?
  avatarUrl      String?
  status         String        @default("ACTIVE")
  totalTcv       Decimal       @default(0) @db.Decimal(14, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects       Project[]
  invoices       ClientInvoice[]

  @@index([organizationId])
  @@map("clients")
}

// ------------------------------------------------------------------------------
// PROJECT & DELIVERABLE ENGINE
// ------------------------------------------------------------------------------
model Project {
  id             String          @id @default(uuid())
  organizationId String
  clientId       String
  name           String
  description    String?
  status         String          @default("IN_PROGRESS") // "PLANNING", "IN_PROGRESS", "REVIEW", "COMPLETED"
  tcv            Decimal         @default(0) @db.Decimal(14, 2)
  allocatedBudget Decimal        @default(0) @db.Decimal(14, 2)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  tasks          Task[]
  invoices       ClientInvoice[]
  payouts        Payout[]
  expenses       DirectExpense[]
  ledgerEntries  FinancialLedger[]

  @@index([organizationId, status])
  @@map("projects")
}

// ------------------------------------------------------------------------------
// TASKS & SPRINT DELIVERABLES
// ------------------------------------------------------------------------------
model Task {
  id             String       @id @default(uuid())
  organizationId String
  projectId      String
  assigneeId     String?
  title          String
  description    String?
  status         String       @default("TODO") // "TODO", "IN_PROGRESS", "REVIEW", "DONE"
  priority       String       @default("MEDIUM") // "LOW", "MEDIUM", "HIGH", "URGENT"
  dueDate        DateTime?
  deliverableUrl String?
  prLink         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([organizationId, projectId])
  @@map("tasks")
}

// ------------------------------------------------------------------------------
// FINANCIALS: CLIENT INVOICES
// ------------------------------------------------------------------------------
model ClientInvoice {
  id             String       @id @default(uuid())
  organizationId String
  projectId      String
  clientId       String
  invoiceNumber  String       @unique
  amount         Decimal      @db.Decimal(12, 2)
  status         String       @default("ISSUED") // "DRAFT", "ISSUED", "PAID", "OVERDUE"
  issuedDate     DateTime     @default(now())
  dueDate        DateTime
  paidDate       DateTime?
  pdfUrl         String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([organizationId, invoiceNumber])
  @@map("client_invoices")
}

// ------------------------------------------------------------------------------
// FINANCIALS: 2-STEP PAYOUT DISBURSEMENTS
// ------------------------------------------------------------------------------
model Payout {
  id             String       @id @default(uuid())
  organizationId String
  projectId      String
  recipientId    String
  amount         Decimal      @db.Decimal(12, 2)
  type           String       @default("SALARY") // "SALARY", "SHARE_PROFIT", "CONTRACT"
  status         String       @default("PENDING") // "PENDING", "VERIFIED_PM", "DISBURSED", "REJECTED"
  verifiedByPmId String?
  disbursedByAdminId String?
  disbursedAt    DateTime?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recipient      User         @relation("PayoutRecipient", fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([organizationId, projectId])
  @@map("payouts")
}

// ------------------------------------------------------------------------------
// FINANCIALS: DIRECT EXPENSES
// ------------------------------------------------------------------------------
model DirectExpense {
  id             String       @id @default(uuid())
  organizationId String
  projectId      String?
  category       String
  amount         Decimal      @db.Decimal(12, 2)
  description    String
  receiptUrl     String?      // Rule 8: Secure S3 UUID file link
  expenseDate    DateTime     @default(now())
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([organizationId, category])
  @@map("direct_expenses")
}

// ------------------------------------------------------------------------------
// FINANCIALS: DOUBLE-ENTRY AUDIT LEDGER
// ------------------------------------------------------------------------------

// ------------------------------------------------------------------------------
// FINANCIALS: EXPENSE CATEGORIES
// ------------------------------------------------------------------------------
model ExpenseCategory {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?      @default("")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@map("expense_categories")
}

model FinancialLedger {
  id             String       @id @default(uuid())
  organizationId String
  projectId      String?
  entryType      String       // "INCOME_INVOICE", "EXPENSE_PAYOUT", "DIRECT_EXPENSE"
  amount         Decimal      @db.Decimal(14, 2)
  referenceId    String?
  notes          String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("financial_ledger")
}

// ------------------------------------------------------------------------------
// ATTENDANCE ROSTER (DAILY VERIFICATION)
// ------------------------------------------------------------------------------
model AttendanceRecord {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  date           String       // Format YYYY-MM-DD
  status         String       // "PRESENT", "ABSENT", "ON_LEAVE"
  checkIn        String?      // HH:mm
  checkOut       String?      // HH:mm
  workMode       WorkMode     @default(ONSITE)
  remarks        String?
  verifiedBy     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, date])
  @@index([organizationId, date])
  @@map("attendance_records")
}

// ------------------------------------------------------------------------------
// IMMUTABLE AUDIT TRAIL (UUIDv4, Actor, IP, JSON Diffs)
// ------------------------------------------------------------------------------
model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  actorId        String?
  action         String       // "LOGIN_SUCCESS", "PAYOUT_DISBURSED", "ATTENDANCE_MARKED"
  resourceType   String       // "PAYOUT", "USER", "PROJECT", "INVOICE"
  resourceId     String?
  ipAddress      String?
  userAgent      String?
  metadata       Json?        // Stores exact JSON before/after state deltas
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}
